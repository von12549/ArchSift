{
  "schemaVersion": 1,
  "id": "template-project-reference",
  "version": "1.0.0",
  "description": "project-reference template. Review selectors and policy reasons before use.",
  "rules": [
    {
      "id": "project-reference-01",
      "type": "project-reference",
      "enabled": true,
      "scope": {
        "kind": "project",
        "match": "glob",
        "value": "**"
      },
      "parameters": {
        "source": {
          "kind": "project",
          "match": "glob",
          "value": "src/Domain/**"
        },
        "target": {
          "kind": "project",
          "match": "glob",
          "value": "src/Infrastructure/**"
        }
      },
      "severity": "warning",
      "reason": "Describe the intended architecture policy."
    }
  ],
  "exceptions": []
}
