{
  "schemaVersion": 1,
  "id": "template-nuget-allowlist",
  "version": "1.0.0",
  "description": "nuget-allowlist template. Review selectors and policy reasons before use.",
  "rules": [
    {
      "id": "nuget-allowlist-01",
      "type": "nuget-allowlist",
      "enabled": true,
      "scope": {
        "kind": "project",
        "match": "glob",
        "value": "**"
      },
      "parameters": {
        "allowedPackageIds": [
          "Microsoft.Extensions.Logging.Abstractions"
        ]
      },
      "severity": "warning",
      "reason": "Describe the intended architecture policy."
    }
  ],
  "exceptions": []
}
