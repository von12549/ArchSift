{
  "schemaVersion": 1,
  "id": "template-nuget-allowlist",
  "version": "1.0.0",
  "description": "nuget-allowlist 模板；只有明确列出的直接 PackageReference ID 才被允许。",
  "rules": [
    {
      "id": "nuget-allowlist-01",
      "type": "nuget-allowlist",
      "enabled": true,
      "scope": {
        "kind": "project",
        "match": "glob",
        "value": "**"
      },
      "parameters": {
        "allowedPackageIds": [
          "Microsoft.Extensions.Logging.Abstractions"
        ]
      },
      "severity": "warning",
      "reason": "请按实际架构政策填写允许的直接包及理由。"
    }
  ],
  "exceptions": []
}
