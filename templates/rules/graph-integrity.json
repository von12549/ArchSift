{
  "schemaVersion": 1,
  "id": "template-graph-integrity",
  "version": "1.0.0",
  "description": "graph-integrity template. Review selectors and policy reasons before use.",
  "rules": [
    {
      "id": "graph-integrity-01",
      "type": "graph-integrity",
      "enabled": true,
      "scope": {
        "kind": "project",
        "match": "glob",
        "value": "**"
      },
      "parameters": {
        "check": "resolved-references"
      },
      "severity": "warning",
      "reason": "Describe the intended architecture policy."
    }
  ],
  "exceptions": []
}
