{
  "schemaVersion": 1,
  "id": "template-naming",
  "version": "1.0.0",
  "description": "naming template. Review selectors and policy reasons before use.",
  "rules": [
    {
      "id": "naming-01",
      "type": "naming",
      "enabled": true,
      "scope": {
        "kind": "project",
        "match": "glob",
        "value": "**"
      },
      "parameters": {
        "subjectKind": "project",
        "requiredName": {
          "match": "glob",
          "value": "Sample.*"
        }
      },
      "severity": "warning",
      "reason": "Describe the intended architecture policy."
    }
  ],
  "exceptions": []
}
