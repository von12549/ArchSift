{
  "schemaVersion": 1,
  "id": "template-project-reference-allowlist",
  "version": "1.0.0",
  "description": "project-reference-allowlist 模板；只有明确列出的直接项目引用目标才被允许。",
  "rules": [
    {
      "id": "project-reference-allowlist-01",
      "type": "project-reference-allowlist",
      "enabled": true,
      "scope": {
        "kind": "project",
        "match": "glob",
        "value": "**"
      },
      "parameters": {
        "source": {
          "kind": "project",
          "match": "glob",
          "value": "src/Application/**"
        },
        "allowedTargets": [
          {
            "kind": "project",
            "match": "glob",
            "value": "src/Domain/**"
          }
        ]
      },
      "severity": "warning",
      "reason": "请按实际架构政策填写允许边界及理由。"
    }
  ],
  "exceptions": []
}
