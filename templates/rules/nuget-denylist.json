{
  "schemaVersion": 1,
  "id": "template-nuget-denylist",
  "version": "1.0.0",
  "description": "nuget-denylist template. Review selectors and policy reasons before use.",
  "rules": [
    {
      "id": "nuget-denylist-01",
      "type": "nuget-denylist",
      "enabled": true,
      "scope": {
        "kind": "project",
        "match": "glob",
        "value": "**"
      },
      "parameters": {
        "forbiddenPackageIds": [
          "Forbidden.Package"
        ]
      },
      "severity": "warning",
      "reason": "Describe the intended architecture policy."
    }
  ],
  "exceptions": []
}
