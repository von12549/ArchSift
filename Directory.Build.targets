<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ArchSift.Contracts' Or '$(MSBuildProjectName)' == 'ArchSift.Core' Or '$(MSBuildProjectName)' == 'ArchSift.ArchUnit' Or '$(MSBuildProjectName)' == 'ArchSift.Testing' Or '$(MSBuildProjectName)' == 'ArchSift.Cli'">
    <PackageId>$(MSBuildProjectName)</PackageId>
    <ArchSiftPackageReadme Condition="'$(ArchSiftPackageReadme)' == ''">$(MSBuildThisFileDirectory)docs/package-readme.md</ArchSiftPackageReadme>
    <ArchSiftPackageReleaseNotes Condition="'$(ArchSiftPackageReleaseNotes)' == ''">$(MSBuildThisFileDirectory)RELEASE_NOTES.md</ArchSiftPackageReleaseNotes>
    <PackageVersion>$(ArchSiftReleaseVersion)</PackageVersion>
    <Authors>ArchSift contributors</Authors>
    <Description>ArchSift architecture analysis and architecture-test tooling.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/von12549/ArchSift</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/von12549/ArchSift</PackageProjectUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ArchSift.Cli'">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>archsift</ToolCommandName>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ArchSift.Contracts' Or '$(MSBuildProjectName)' == 'ArchSift.Core' Or '$(MSBuildProjectName)' == 'ArchSift.ArchUnit' Or '$(MSBuildProjectName)' == 'ArchSift.Testing' Or '$(MSBuildProjectName)' == 'ArchSift.Cli'">
    <None Include="$(ArchSiftPackageReadme)" Pack="true" PackagePath="README.md" />
    <None Include="$(ArchSiftPackageReleaseNotes)" Pack="true" PackagePath="RELEASE_NOTES.md" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(ArchSiftPackageDocumentationRoot)' != '' And ('$(MSBuildProjectName)' == 'ArchSift.Contracts' Or '$(MSBuildProjectName)' == 'ArchSift.Core' Or '$(MSBuildProjectName)' == 'ArchSift.ArchUnit' Or '$(MSBuildProjectName)' == 'ArchSift.Testing' Or '$(MSBuildProjectName)' == 'ArchSift.Cli')">
    <None Include="$(ArchSiftPackageDocumentationRoot)/docs/**/*" Pack="true" PackagePath="docs/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(ArchSiftPackageDocumentationRoot)/schemas/**/*" Pack="true" PackagePath="schemas/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(ArchSiftPackageDocumentationRoot)/templates/**/*" Pack="true" PackagePath="templates/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(ArchSiftPackageDocumentationRoot)/samples/**/*" Pack="true" PackagePath="samples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- NuGet Pack consumes ProjectVersion as a range; product packages must stay in one release. -->
  <Target Name="PinArchSiftPackageDependencies" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" Condition="$([System.IO.Path]::GetFileNameWithoutExtension('%(_ProjectReferencesWithVersions.Identity)').StartsWith('ArchSift.'))">
        <ProjectVersion>[$(ArchSiftReleaseVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
