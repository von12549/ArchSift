{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:archsift:chain:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entryId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "entryId"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "entries"
  ]
}
