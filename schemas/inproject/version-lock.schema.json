{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:archsift:inproject:version-lock:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "rid", "sourceCommit", "contractVersion", "packageSha256", "payloadManifestSha256", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "ArchSift.InProject" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "rid": { "const": "win-x64" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contractVersion": { "const": 1 },
    "packageSha256": { "$ref": "#/definitions/sha256" },
    "payloadManifestSha256": { "$ref": "#/definitions/sha256" },
    "components": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256"],
        "properties": {
          "id": { "enum": ["ArchSift.InProject", "ArchSift.InProject.Runtime", "ArchSift.InProject.TestBridge", "ArchSift.Contracts", "ArchSift.Core", "ArchSift.ArchUnit", "ArchSift.Cli.Worker"] },
          "sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
