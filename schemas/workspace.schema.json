{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchSift project workspace",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schemaVersion", "project"],
  "properties": {
    "kind": { "const": "archsift-workspace" }, "schemaVersion": { "const": 1 },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" }, "root": { "$ref": "#/definitions/path" }, "entry": { "$ref": "#/definitions/optionalPath" } }
    },
    "state": { "type": "object", "additionalProperties": false, "properties": { "root": { "$ref": "#/definitions/path" } } },
    "nuget": {
      "type": "object", "additionalProperties": false,
      "properties": { "mode": { "enum": ["configured", "offline"] }, "allowNetwork": { "type": "boolean" }, "configFile": { "$ref": "#/definitions/optionalPath" }, "cacheDirectory": { "$ref": "#/definitions/optionalPath" }, "sourceApprovalFile": { "$ref": "#/definitions/optionalPath" } }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "properties": { "mode": { "enum": ["host", "approvedExact"] }, "dotnetPath": { "$ref": "#/definitions/optionalPath" }, "minimumSdkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "maximumSdkVersionExclusive": { "$ref": "#/definitions/optionalSdkVersion" }, "allowPrerelease": { "type": "boolean" }, "approvalFile": { "$ref": "#/definitions/optionalPath" } }
    },
    "workbench": {
      "type": "object", "additionalProperties": false,
      "properties": { "rulesets": { "type": "array", "items": { "$ref": "#/definitions/path" }, "uniqueItems": true }, "policyFile": { "$ref": "#/definitions/optionalPath" },
        "build": { "type": "object", "additionalProperties": false, "properties": { "mode": { "const": "existing" }, "configuration": { "$ref": "#/definitions/path" }, "targetFramework": { "$ref": "#/definitions/optionalPath" }, "assemblyManifest": { "$ref": "#/definitions/optionalPath" }, "assemblyPaths": { "type": "array", "items": { "$ref": "#/definitions/path" } }, "allowNetwork": { "const": false }, "sources": { "type": "array", "maxItems": 0 }, "localFeed": { "$ref": "#/definitions/optionalPath" }, "cacheDirectory": { "$ref": "#/definitions/optionalPath" } } }
      }
    },
    "gate": { "type": ["object", "null"], "additionalProperties": false, "required": ["kind", "metadataFile"], "properties": { "kind": { "const": "ifx" }, "metadataFile": { "$ref": "#/definitions/path" } } }
  },
  "definitions": { "path": { "type": "string", "minLength": 1 }, "optionalPath": { "type": ["string", "null"], "minLength": 1 }, "optionalSdkVersion": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } }
}
