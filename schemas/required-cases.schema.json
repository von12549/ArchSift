{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:archsift:required-cases:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "sdk", "runner", "targetFramework", "packageVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "archsift-required-cases" },
    "sdk": { "const": "10.0.303" },
    "runner": { "const": "mtp-ctrf/xunit-v3-4.0.1" },
    "targetFramework": { "const": "net10.0" },
    "packageVersion": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["group", "identity"],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "identity": { "type": "object", "additionalProperties": false,
          "required": ["assembly", "type", "method", "parameterTypes", "arguments"],
          "properties": {
            "assembly": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "parameterTypes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "arguments": { "type": "array", "items": { "type": "object", "additionalProperties": false,
              "required": ["declaredType", "kind"], "properties": {
                "declaredType": { "type": "string", "minLength": 1 }, "runtimeType": { "type": "string" },
                "value": { "type": "string" },
                "kind": { "enum": ["null", "string", "type", "enum", "boolean", "char", "float", "number"] }
              }
            } }
          }
        }
      }
    } }
  }
}
