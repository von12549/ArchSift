            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "type",
            "enabled",
            "scope",
            "parameters",
            "severity",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "type-dependency"
            },
            "enabled": {
              "type": "boolean"
            },
            "scope": {
              "$ref": "#/definitions/selector"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
