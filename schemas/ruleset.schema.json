            "severity": {
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "type",
            "enabled",
            "scope",
            "parameters",
            "severity",
