            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "type",
            "enabled",
            "scope",
            "parameters",
            "severity",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "nuget-denylist"
