<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Cut the stable version here in a reviewed source/lock commit; release scripts consume it unchanged. -->
    <ArchSiftReleaseVersion Condition="'$(ArchSiftReleaseVersion)' == ''">0.11.1</ArchSiftReleaseVersion>
    <ArchSiftBundledRuntimeVersion>10.0.13</ArchSiftBundledRuntimeVersion>
    <Version>$(ArchSiftReleaseVersion)</Version>
    <VersionPrefix>$([System.String]::Copy('$(ArchSiftReleaseVersion)').Split('-')[0])</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
    <!-- Offline development checks cannot query vulnerability feeds. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
