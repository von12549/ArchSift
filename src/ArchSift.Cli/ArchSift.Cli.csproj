<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>archsift</AssemblyName>
    <ArchSiftPackageNotices Condition="'$(ArchSiftPackageNotices)' == ''">$(MSBuildThisFileDirectory)../../docs/migration/third-party-notices.md</ArchSiftPackageNotices>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/workspace*.schema.json" />
    <None Include="../../schemas/workspace*.schema.json" Pack="true" PackagePath="tools/net10.0/any/schemas/" />
    <None Include="../../templates/project/**/*" Exclude="../../templates/project/.archsift/start.ps1" Pack="true" PackagePath="tools/net10.0/any/templates/project/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Shared/WebPayload.cs" Link="WebPayload.cs" />
    <None Include="$(ArchSiftPackageNotices)" Pack="true" PackagePath="tools/net10.0/any/notices/third-party-notices.md" />
    <None Include="../../docs/migration/licenses/*" Pack="true" PackagePath="tools/net10.0/any/notices/licenses/" />
    <Compile Include="../Shared/UiProcess.cs" Link="UiProcess.cs" />
    <ProjectReference Include="../ArchSift.Core/ArchSift.Core.csproj" />
    <ProjectReference Include="../ArchSift.ArchUnit/ArchSift.ArchUnit.csproj" />
    <ProjectReference Include="../ArchSift.TestGate/ArchSift.TestGate.csproj" />
  </ItemGroup>
  <Target Name="IncludeMatchingWebPublish" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="../../templates/project/.archsift/start.ps1" DestinationFiles="$(IntermediateOutputPath)project-template/start.ps1.template" />
    <Error Condition="'$(ArchSiftWebPayloadRoot)' == '' Or !Exists('$(ArchSiftWebPayloadRoot)/web-payload.json')" Text="Distributable CLI pack requires a complete version/source-bound Web publish closure. Run Build-WorkbenchRelease.ps1 or supply ArchSiftWebPayloadRoot." />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)../../scripts/New-WebPayloadInventory.ps1&quot; -PayloadRoot &quot;$(ArchSiftWebPayloadRoot)&quot; -ExpectedVersion &quot;$(ArchSiftReleaseVersion)&quot; -SourceCommit &quot;$(SourceRevisionId)&quot; -VerifyOnly" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)project-template/start.ps1.template" Pack="true" PackagePath="tools/net10.0/any/templates/project/.archsift/" />
      <_ArchSiftWebPublishFiles Include="$(ArchSiftWebPayloadRoot)/**/*" />
      <None Include="@(_ArchSiftWebPublishFiles)" Pack="true" PackagePath="tools/net10.0/any/web/%(_ArchSiftWebPublishFiles.RecursiveDir)%(_ArchSiftWebPublishFiles.Filename)%(_ArchSiftWebPublishFiles.Extension)" />
    </ItemGroup>
  </Target>
</Project>
