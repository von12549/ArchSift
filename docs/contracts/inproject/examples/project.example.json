{
  "schemaVersion": 1,
  "product": "ArchSift.InProject",
  "solution": "../Product.slnx",
  "rulesets": ["rules/architecture.json"],
  "build": {
    "configuration": "Debug",
    "contexts": [
      { "project": "../src/Legacy/Legacy.csproj", "targetFramework": "net8.0" },
      { "project": "../src/Modern/Modern.csproj", "targetFramework": "net10.0" }
    ],
    "allowNetwork": false,
    "networkSources": []
  },
  "retention": { "dailyDays": 30, "dailyMaxRuns": 100 }
}
